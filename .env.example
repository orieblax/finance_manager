# ==============================================================================
# Personal Finance Manager - Environment Configuration Template
# ==============================================================================

# Public Web URL (Production deployment)
NEXT_PUBLIC_APP_URL=https://your-app-domain.vercel.app

# Supabase Public API Credentials (Client-side / SSR safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Supabase Server & Backend Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-secret-key-here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Optional: Dedicated Golang Backend Port & Supabase API URL override
PORT=8080
GOLANG_API_URL=http://localhost:8080
